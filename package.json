{
  "name": "moolin",
  "version": "0.1.0",
  "description": "Buttery-smooth MUSH/MUCK/MOO scrollback client",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:main": "esbuild src/main.ts --bundle --platform=node --external:electron --outfile=dist/main.js",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --external:electron --outfile=dist/preload.js",
    "build:renderer": "esbuild src/renderer.ts src/worlds-renderer.ts --bundle --platform=browser --outdir=dist",
    "build": "npm run typecheck && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:test": "esbuild src/telnet.test.ts --bundle --platform=node --outfile=dist/telnet.test.js",
    "test": "npm run build:test && node --test dist/telnet.test.js",
    "start": "npm run build && electron .",
    "dev": "npm-run-all --parallel dev:main dev:preload dev:renderer",
    "dev:main": "esbuild src/main.ts --bundle --platform=node --external:electron --outfile=dist/main.js --watch",
    "dev:preload": "esbuild src/preload.ts --bundle --platform=node --external:electron --outfile=dist/preload.js --watch",
    "dev:renderer": "esbuild src/renderer.ts src/worlds-renderer.ts --bundle --platform=browser --outdir=dist --watch"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "telnet-stream": "^1.1.0"
  }
}
