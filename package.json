{
  "name": "moolin",
  "productName": "Moolin",
  "version": "0.1.0",
  "description": "A MOO/MUSH/MUCK/MUD client with buttery-smooth scrollback",
  "license": "MIT",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:main": "esbuild src/main.ts --bundle --platform=node --external:electron --outfile=dist/main.js",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --external:electron --outfile=dist/preload.js",
    "build:renderer": "esbuild src/renderer.ts --bundle --platform=browser --outdir=dist",
    "build": "npm run typecheck && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:test": "esbuild src/*.test.ts --bundle --platform=node --outdir=dist/test",
    "test": "npm run build:test && node --test \"dist/test/*.test.js\"",
    "start": "npm run build && node scripts/start.js",
    "dev": "npm-run-all --parallel dev:main dev:preload dev:renderer",
    "dev:main": "esbuild src/main.ts --bundle --platform=node --external:electron --outfile=dist/main.js --watch",
    "dev:preload": "esbuild src/preload.ts --bundle --platform=node --external:electron --outfile=dist/preload.js --watch",
    "dev:renderer": "esbuild src/renderer.ts --bundle --platform=browser --outdir=dist --watch"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  }
}
