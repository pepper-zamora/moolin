{
  "name": "moolin",
  "version": "0.1.0",
  "description": "Buttery-smooth MUSH/MUCK/MOO scrollback client",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "esbuild src/renderer.ts --bundle --platform=browser --outfile=dist/renderer.js",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm-run-all --parallel dev:main dev:renderer",
    "dev:main": "tsc -p tsconfig.json --watch",
    "dev:renderer": "esbuild src/renderer.ts --bundle --platform=browser --outfile=dist/renderer.js --watch"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0"
  }
}
