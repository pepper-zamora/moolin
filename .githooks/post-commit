#!/usr/bin/env bash
# Keep commit dates in UTC: replace the new commit with one whose author and
# committer dates are +0000, at the same instant. Its tree, parents, message,
# names and emails are unchanged. post-merge runs this too.
set -euo pipefail

gitdir=$(git rev-parse --git-dir)
# Don't rewrite in the middle of a rebase; pre-push catches anything left over.
[[ -d $gitdir/rebase-merge || -d $gitdir/rebase-apply ]] && exit 0

zones=$(git log -1 --format='%ad %cd' --date=format:%z)
[[ $zones == '+0000 +0000' ]] && exit 0

old=$(git rev-parse HEAD)
fmt='format-local:%Y-%m-%dT%H:%M:%S+0000'
parents=()
for p in $(git log -1 --format=%P); do
  parents+=(-p "$p")
done

new=$(git cat-file commit HEAD | sed '1,/^$/d' |
  GIT_AUTHOR_NAME=$(git log -1 --format=%an) \
  GIT_AUTHOR_EMAIL=$(git log -1 --format=%ae) \
  GIT_AUTHOR_DATE=$(TZ=UTC git log -1 --format=%ad --date="$fmt") \
  GIT_COMMITTER_NAME=$(git log -1 --format=%cn) \
  GIT_COMMITTER_EMAIL=$(git log -1 --format=%ce) \
  GIT_COMMITTER_DATE=$(TZ=UTC git log -1 --format=%cd --date="$fmt") \
  git commit-tree "$(git rev-parse 'HEAD^{tree}')" "${parents[@]}")

git update-ref -m "commit dates to UTC" HEAD "$new" "$old"
