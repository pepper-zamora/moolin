#!/usr/bin/env bash
# Refuse to push commits whose author or committer date is not in UTC (+0000).
# Commits already on a remote are not checked.
set -euo pipefail

zero=0000000000000000000000000000000000000000
bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ $local_sha == "$zero" ]] && continue   # deleting a branch
  # Only commits on no remote branch yet, so merging in another branch's
  # history (such as main into dev) doesn't trip over its older commits.
  while read -r sha az cz; do
    if [[ $az != +0000 || $cz != +0000 ]]; then
      echo "pre-push: $sha has a non-UTC date (author $az, committer $cz)" >&2
      bad=1
    fi
  done < <(git log --format='%h %ad %cd' --date=format:%z "$local_sha" --not --remotes)
done

if (( bad )); then
  echo "pre-push: fix with TZ=UTC dates (e.g. amend or rebase) before pushing." >&2
  exit 1
fi
